# Environment Configuration for ITILSuite Backend (v0.0.1)

# HTTP Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
ENVIRONMENT=development

# PostgreSQL Database (Ready for v0.0.2 in docker-compose)
DATABASE_URL=postgres://itilsuite:itilsuite_dev_password@localhost:5432/itilsuite_db
DATABASE_MAX_CONNECTIONS=20

# Security & Authentication (Prepared for v0.0.2)
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_bytes_long!
JWT_EXPIRATION_HOURS=24

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging (trace, debug, info, warn, error)
RUST_LOG=info,itilsuite_backend=debug,tower_http=info
